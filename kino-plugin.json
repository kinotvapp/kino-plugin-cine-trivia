{
  "id": "cine-trivia",
  "name": "Cine Trivia",
  "version": "1.0.2",
  "apiVersion": 20,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Cinco preguntas de cine, quince segundos cada una: las películas llegan del plugin TMDB",
  "categories": [
    "utilities"
  ],
  "author": "kinotvapp",
  "hosts": [],
  "capabilities": [
    "screen"
  ],
  "screen": {
    "label": "Cine Trivia",
    "labelEn": "Cine Trivia",
    "icon": "movie",
    "menuOpens": "screen"
  },
  "recommends": [
    "kinotvapp/kino-plugin-tmdb"
  ],
  "consumes": {
    "tmdb": {
      "repo": "kinotvapp/kino-plugin-tmdb",
      "door": "movies",
      "calls": [
        "random",
        "byId"
      ],
      "streams": [
        "trending"
      ]
    }
  }
}